# Variáveis de ambiente do backend Top Filme.
# Em DEV: deixe tudo em branco — o settings.py tem fallbacks sensatos para SQLite + localhost.
# Em PROD (Railway): configure todas no painel do serviço.

# ─── Core ─────────────────────────────────────────────────────────
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.topfilme.com.br,topfilme-api.up.railway.app

# ─── Banco (Railway injeta DATABASE_URL automaticamente quando conectado ao Postgres) ─
DATABASE_URL=

# ─── CORS ─────────────────────────────────────────────────────────
# Domínio do frontend (sem barra no final)
CORS_ALLOWED_ORIGINS=https://topfilme.com.br,https://topfilme-frontend.up.railway.app

# ─── CSRF ─────────────────────────────────────────────────────────
# Admin Django exige lista explícita em produção. Mesmo domínio do backend.
CSRF_TRUSTED_ORIGINS=https://topfilme-api.up.railway.app
