# Variáveis de ambiente do backend Top Filme.
# Em DEV: deixe tudo em branco — settings.py tem fallbacks sensatos (SQLite + localhost).
# Em PROD (Railway): usar Railway Reference Variables, ver doc/deploy.md.

# ─── Core ─────────────────────────────────────────────────────────
# Gerar com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=False

# ─── Hosts ────────────────────────────────────────────────────────
# Em prod no Railway: ${{RAILWAY_PUBLIC_DOMAIN}}
# Lista separada por vírgula se precisar múltiplos
ALLOWED_HOSTS=

# ─── Banco ────────────────────────────────────────────────────────
# Em prod no Railway: ${{Postgres.DATABASE_URL}}
# Vazio em dev = SQLite local
DATABASE_URL=

# ─── CORS (origem do frontend) ────────────────────────────────────
# Em prod no Railway: https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
# Lista separada por vírgula se precisar múltiplos origens
CORS_ALLOWED_ORIGINS=

# ─── CSRF (admin Django em prod exige) ────────────────────────────
# Em prod no Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
CSRF_TRUSTED_ORIGINS=

# ─── Superuser (criado no release command via ensure_superuser) ──
# Se as três estiverem definidas, o deploy cria o admin automaticamente
# na primeira vez. Já existe? O command faz no-op. Pode manter definidas
# sem risco. Em DEV, deixar vazio e criar via `python manage.py createsuperuser`.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
